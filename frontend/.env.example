# --- Frontend FinTech Risk Intelligence — variables PUBLIQUES (aucun secret ici) ---
# Tout ce qui est préfixé VITE_ est embarqué dans le bundle et visible par l'utilisateur.

# Active MSW (API fictives) et le bandeau « Données simulées ».
VITE_USE_MOCKS=true

# Stratégie d'authentification : "demo" (Lot 1, sans JWT) | "jwt" (futur, validé avec P1).
VITE_AUTH_MODE=demo

# Base des API : chemin relatif, servi par l'API Gateway.
VITE_API_BASE_URL=/api/v1

# Lien externe vers Grafana (application séparée, jamais d'iframe).
VITE_GRAFANA_URL=http://localhost:3000

# Dev uniquement (non embarqué) : proxy Vite vers une Gateway locale.
# VITE_DEV_API_TARGET=http://localhost:8080
