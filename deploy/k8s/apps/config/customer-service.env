SERVER_SHUTDOWN=graceful
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=20s
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_GROUP_LIVENESS_INCLUDE=livenessState
MANAGEMENT_ENDPOINT_HEALTH_GROUP_READINESS_INCLUDE=readinessState,db
JWKS_URI=http://auth-service.fintech.svc.cluster.local:8081/.well-known/jwks.json
DB_URL=jdbc:postgresql://postgres.data.svc.cluster.local:5432/fintech
